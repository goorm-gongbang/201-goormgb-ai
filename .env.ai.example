# =============================================================================
# AI Defense Server — Environment Variables Template
#
# Usage (로컬 개발):
#   cp .env.ai.example .env.ai
#   set -a; source .env.ai; set +a
#
# 참고 문서: spec/cloud_team_handover_cicd_deployment.md §2.2
# =============================================================================

# -----------------------------------------------------------------------------
# [Core / 필수] MVP 가동에 반드시 필요한 변수
# -----------------------------------------------------------------------------

# Redis 실시간 세션 상태 저장소 (필수 — 미설정 시 In-Memory fallback, Pod 간 상태 공유 불가)
TM_REDIS_URL=redis://localhost:6379/0

# 백엔드 유저 제재 API URL (선택 — 미설정 시 제재 기능 비활성화)
TM_BACKEND_SANCTION_URL=

# -----------------------------------------------------------------------------
# [Storage / Staging 이상] S3 아카이빙 및 PostgreSQL 분석 레이어
# -----------------------------------------------------------------------------

# S3 버킷 이름 (미설정 시 로컬 JSONL 파일 모드로 동작)
TM_S3_BUCKET=
# S3 오브젝트 Key Prefix
TM_S3_PREFIX=ai-defense/audit/
# S3 버킷 리전
TM_S3_REGION=

# PostgreSQL 접속 URL (ETL 분석 레이어, 미설정 시 비활성)
TM_PG_URL=

# -----------------------------------------------------------------------------
# [Security] Admin Console 접근 토큰 (운영 환경에서 반드시 설정)
# -----------------------------------------------------------------------------
TM_ADMIN_SHARED_TOKEN=
TM_ADMIN_READONLY_TOKEN=
TM_ADMIN_OPERATOR_TOKEN=

# -----------------------------------------------------------------------------
# [LLM / 선택] 오프라인 최적화 파이프라인 (실시간 판정에 사용하지 않음)
# -----------------------------------------------------------------------------
TM_OFFLINE_LLM_API_KEY=
TM_OFFLINE_LLM_ENDPOINT=https://api.openai.com/v1
TM_OFFLINE_LLM_MODEL=gpt-5-mini

# -----------------------------------------------------------------------------
# [System / 선택] 서버 시스템 설정
# -----------------------------------------------------------------------------
APP_PORT=8000
# CI=true 설정 시 Redis 연결 없이 In-Memory로 동작 (CI 환경 전용)
CI=

# -----------------------------------------------------------------------------
# [Tuning / 선택] 방어 정책 파라미터 (기본값 사용 권장)
# -----------------------------------------------------------------------------

# 위험도 티어 임계치
TM_T0_MAX=0.20
TM_T1_MAX=0.50
TM_T2_MAX=0.80
TM_TIER_HYSTERESIS_MARGIN=0.02
TM_RISK_ALPHA=0.30

# 세션 및 차단 TTL (초)
TM_SESSION_STATE_TTL_SECONDS=1800
TM_BLOCK_TTL_SECONDS=1800
TM_S3_GRACE_TTL_SECONDS=180
TM_POLICY_CACHE_SECONDS=5

# Challenge / VQA
TM_CHALLENGE_TTL_SECONDS=15
TM_CHALLENGE_VERIFY_TIMEOUT_MS=200
TM_CHALLENGE_MAX_ATTEMPTS=2
TM_CHALLENGE_HALT_SECONDS=30
TM_S3_VERIFY_UNAVAILABLE_MODE=fail_close

# Throttle (딜레이 주입)
TM_THROTTLE_DELAY_MS_T1=80
TM_THROTTLE_DELAY_MS_T2=250
TM_THROTTLE_MAX_DELAY_MS=2000

# Turnstile
TM_TURNSTILE_ENABLED=true
TM_TURNSTILE_VERIFY_TIMEOUT_MS=500
TM_TURNSTILE_CACHE_TTL_SECONDS=600

# Audit 로그 파일 경로
TM_DEFENSE_AUDIT_LOG_PATH=logs/defense_decision_audit.jsonl
