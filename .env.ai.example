# =============================================================================
# Traffic Master AI Defense — 환경변수 템플릿
# =============================================================================
#
# [Cloud팀 안내]
# 모든 변수에 기본값이 코드에 내장되어 있어, 생략하면 기본값으로 동작합니다.
# 반드시 값을 설정해야 하는 변수:
#   - TM_REDIS_URL        : Redis 인스턴스 URL (없으면 in-memory fallback - Pod간 상태 공유 불가)
#   - TM_ADMIN_*_TOKEN    : Admin API 보호용 토큰 (staging/prod 필수, Cloud팀이 값 생성)
# 나머지는 기본값 그대로 사용 가능합니다.
# 튜닝 수치 변경이 필요하면 AI팀이 값을 전달드리겠습니다.
#
# 사용법 (로컬):
#   cp .env.ai.example .env.ai
#   set -a; source .env.ai; set +a
# =============================================================================

# -----------------------------------------------------------------------------
# [Server] Bind settings (used by Dockerfile CMD)
# -----------------------------------------------------------------------------
APP_PORT=8000
# Host is hardcoded to 0.0.0.0 in Dockerfile CMD.

# -----------------------------------------------------------------------------
# [Required in cloud] Runtime backend
# -----------------------------------------------------------------------------
# redis://<host>:<port>/<db>
# When set, Redis is used for session state. When empty, in-memory fallback.
TM_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# [Recommended] Basic runtime
# -----------------------------------------------------------------------------
TM_SESSION_STATE_TTL_SECONDS=1800
TM_BLOCK_TTL_SECONDS=1800
TM_S3_GRACE_TTL_SECONDS=180
TM_POLICY_CACHE_SECONDS=5
TM_DEFENSE_POLICY_VERSION=v2.0.0-mvp
TM_DEFENSE_AUDIT_LOG_PATH=logs/defense_decision_audit.jsonl

# -----------------------------------------------------------------------------
# [Security/Access] Admin console tokens
# -----------------------------------------------------------------------------
# At least one token should be set in production.
TM_ADMIN_SHARED_TOKEN=
TM_ADMIN_READONLY_TOKEN=
TM_ADMIN_OPERATOR_TOKEN=

# -----------------------------------------------------------------------------
# [Guard / Tiering]
# -----------------------------------------------------------------------------
TM_RISK_ALPHA=0.30
TM_T0_MAX=0.20
TM_T1_MAX=0.50
TM_T2_MAX=0.80
TM_TIER_HYSTERESIS_MARGIN=0.02
TM_S3_PROBATION_SECONDS=45

# -----------------------------------------------------------------------------
# [Challenge / VQA]
# -----------------------------------------------------------------------------
TM_CHALLENGE_TTL_SECONDS=15
TM_CHALLENGE_VERIFY_TIMEOUT_MS=200
TM_S3_VERIFY_UNAVAILABLE_MODE=fail_close
TM_S3_VERIFY_UNAVAILABLE_HTTP_STATUS=503
TM_CHALLENGE_MAX_ATTEMPTS=2
TM_CHALLENGE_COOLDOWN_MS_1=0
TM_CHALLENGE_COOLDOWN_MS_2=2500
TM_CHALLENGE_HALT_SECONDS=30
TM_CHALLENGE_ATTEMPT_WINDOW_SECONDS=60
TM_CHALLENGE_CATCH_RADIUS_PX=48
TM_CHALLENGE_TIMING_WINDOW_MS=320

# -----------------------------------------------------------------------------
# [Throttle]
# -----------------------------------------------------------------------------
TM_THROTTLE_DELAY_MS_T1=80
TM_THROTTLE_DELAY_MS_T2=250
TM_THROTTLE_MAX_DELAY_MS=2000

# -----------------------------------------------------------------------------
# [Turnstile]
# -----------------------------------------------------------------------------
TM_TURNSTILE_ENABLED=true
TM_TURNSTILE_VERIFY_TIMEOUT_MS=500
TM_TURNSTILE_VERIFY_BACKOFF_MS=30
TM_TURNSTILE_CACHE_TTL_SECONDS=600
TM_TURNSTILE_MAX_RUNS_PER_SESSION=1
TM_TURNSTILE_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# [Dedup / Session lock]
# -----------------------------------------------------------------------------
TM_DEDUP_TS_BUCKET_MS=200
TM_DEDUP_TTL_SECONDS=600
TM_SESSION_DIST_LOCK_ENABLED=true
TM_SESSION_DIST_LOCK_WAIT_MS=200
TM_SESSION_DIST_LOCK_TTL_MS=2000

# -----------------------------------------------------------------------------
# [Optional] Offline optimization / LLM (not used on runtime request path)
# -----------------------------------------------------------------------------
TM_OFFLINE_LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TM_OFFLINE_LLM_MODEL=gpt-5-mini
TM_OFFLINE_LLM_MAX_SAMPLE_TRACES=50
