# =============================================================================
# AI Defense Server — Environment Variables Template
#
# Usage:
#   cp .env.ai.example .env.ai
#   set -a; source .env.ai; set +a
# =============================================================================

# -----------------------------------------------------------------------------
# [Core Runtime]
# -----------------------------------------------------------------------------

TM_REDIS_URL=redis://localhost:6379/0
TM_SESSION_STATE_TTL_SECONDS=1800
# CI=true 설정 시 Redis 연결 없이 In-Memory로 동작 (개발/테스트 전용)
CI=

# -----------------------------------------------------------------------------
# [Auth-Guard Internal API]
# -----------------------------------------------------------------------------

INTERNAL_API_KEY=
AUTH_GUARD_URL=http://auth-guard:8080/auth

# -----------------------------------------------------------------------------
# [Turnstile Precheck]
# -----------------------------------------------------------------------------

TM_TURNSTILE_SECRET_KEY=
TM_TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TM_TURNSTILE_VERIFY_TIMEOUT_MS=500
TM_PRECHECK_TTL_MS=300000

# -----------------------------------------------------------------------------
# [Challenge Runtime]
# -----------------------------------------------------------------------------

TM_CHALLENGE_SECRET=tm-local-dev-secret
TM_CHALLENGE_TTL_MS=120000
TM_CHALLENGE_RETRY_LIMIT=2
TM_CHALLENGE_MAX_EVENTS=6000
TM_CHALLENGE_MIN_EVENTS=25
TM_CHALLENGE_MIN_DURATION_MS=400
TM_CHALLENGE_MAX_DURATION_MS=7000
TM_CHALLENGE_MAX_SPEED_PX_PER_MS=3.8
TM_CHALLENGE_MAX_JUMP_PX=220
TM_CHALLENGE_CATCH_RADIUS_PX=38
TM_CHALLENGE_TIMING_WINDOW_MS=260

# -----------------------------------------------------------------------------
# [Policy]
# -----------------------------------------------------------------------------

TM_DEFENSE_POLICY_VERSION=def-pol-2.0.0
TM_CHALLENGE_FAIL_THRESHOLD=3
TM_REPETITIVE_PATTERN_T1_THRESHOLD=1
TM_REPETITIVE_PATTERN_T2_THRESHOLD=3
TM_T1_THROTTLE_MS=200
TM_T2_THROTTLE_MS=1800
TM_HIGH_VALUE_PATH_PREFIXES=/queue/matches/,/seat/matches/
TM_VQA_GATE_PATH_PREFIXES=/queue/matches/,/seat/matches/
TM_CHALLENGE_API_PATH_PREFIXES=/ai/challenge/start,/ai/challenge/verify,/api/security/challenge,/api/security/verify

# -----------------------------------------------------------------------------
# [D0 Runtime Compatibility]
# -----------------------------------------------------------------------------

TM_CHALLENGE_MAX_ATTEMPTS=2

# -----------------------------------------------------------------------------
# [Audit / Storage]
# -----------------------------------------------------------------------------

TM_DEFENSE_AUDIT_LOG_PATH=logs/defense_decision_audit.jsonl
TM_AUDIT_JSONL_PATH=
TM_S3_BUCKET=
TM_S3_PREFIX=ai-defense/audit/
TM_S3_REGION=
TM_S3_ARCHIVE_INTERVAL_SECONDS=3600
TM_PG_URL=

# -----------------------------------------------------------------------------
# [Observability]
# -----------------------------------------------------------------------------

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=ai-defense
OTEL_SERVICE_NAMESPACE=dev-ai

# -----------------------------------------------------------------------------
# [Offline Judgment / Backoffice Copilot]
# -----------------------------------------------------------------------------

TM_OFFLINE_LLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TM_OFFLINE_LLM_MODEL=gpt-5-mini

# -----------------------------------------------------------------------------
# [LangSmith]
# -----------------------------------------------------------------------------

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tm-ai
LANGSMITH_WORKSPACE_ID=
TM_AI_ENV=dev

# -----------------------------------------------------------------------------
# [Browser CORS]
# -----------------------------------------------------------------------------

TM_CORS_ALLOW_ORIGINS=https://dev.goormgb.space,http://localhost:3000,http://127.0.0.1:3000
